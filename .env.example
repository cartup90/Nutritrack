# ===========================================================================
#  NutriTrack — Configuración de PRODUCCIÓN
#
#  Copia este archivo a `.env` (SIN el .example) en el VPS y rellena los
#  valores. El `.env` está en .gitignore: NUNCA se sube al repositorio.
#
#      cp .env.example .env
#      nano .env
#
#  Lo usan docker-compose.prod.yml y el Caddyfile.
# ===========================================================================

# ---------------------------------------------------------------------------
# Dominio
#
# Elige UNA de estas dos opciones:
#
#   a) Sin dominio propio (para probar HTTPS ya, gratis):
#      sslip.io es un DNS comodín: cualquier nombre terminado en TU-IP.sslip.io
#      resuelve a esa IP. Caddy obtiene un certificado válido igual.
#          DOMAIN=nutritrack.203.0.113.45.sslip.io
#      (sustituye 203.0.113.45 por la IP pública de tu VPS)
#
#   b) Con dominio propio:
#          DOMAIN=nutritrack.tudominio.com
#      Antes hay que crear un registro DNS de tipo A apuntando a la IP del VPS,
#      y esperar a que propague (de minutos a unas horas).
# ---------------------------------------------------------------------------
DOMAIN=nutritrack.TU_IP.sslip.io

# Correo para los avisos de Let's Encrypt (caducidad del certificado)
ACME_EMAIL=tu@email.com

# Pon "true" mientras haces pruebas para no gastar el límite de Let's Encrypt
# (el certificado será de pruebas y el navegador avisará). Luego pon "false".
ACME_STAGING=false

# ---------------------------------------------------------------------------
# Base de datos
#
# Genera una contraseña larga y aleatoria:
#     openssl rand -base64 24
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_ESTO_por_una_clave_larga_y_aleatoria
POSTGRES_DB=nutritrack

# ---------------------------------------------------------------------------
# Autenticación
#
# GENERA UNO NUEVO. Que sea distinto del de desarrollo:
#     openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=CAMBIA_ESTO_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Día lógico del usuario
#
# El servidor corre en UTC, pero el "día" de la app tiene que ser el del
# usuario. El navegador manda su zona en la cabecera X-Timezone; APP_TIMEZONE
# es el respaldo cuando no llega o no es válida.
#
# DAY_START_HOUR es la hora a la que cambia el día:
#   0 -> a medianoche local
#   1 -> a la 01:00 local: lo comido entre las 00:00 y la 01:00 sigue contando
#        para el día anterior, que es lo práctico si se cena tarde.
#
# Sin esto, y con el servidor en UTC, en Argentina el resumen del día se
# vaciaba a las 21:00 y las cenas posteriores aparecían en el día siguiente.
# ---------------------------------------------------------------------------
APP_TIMEZONE=America/Argentina/Buenos_Aires
DAY_START_HOUR=1

# ---------------------------------------------------------------------------
# DeepSeek — la API key vive SOLO aquí, nunca en el frontend
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-tu_api_key_de_deepseek
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Modelo con visión para analizar las fotos de los platos
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODEL=deepseek-flash

# Presupuesto de tokens. No bajes DEEPSEEK_MAX_TOKENS de 8000: el análisis de
# imágenes consume 2000-4000 solo en razonar y devolvería respuestas vacías.
DEEPSEEK_TIMEOUT_MS=90000
DEEPSEEK_MAX_TOKENS=8000

# Reintento del análisis: 1 de cada ~7 respuestas llega con el JSON truncado.
# Con 2 intentos se resuelve; con 1 se desactiva.
DEEPSEEK_ANALYSIS_ATTEMPTS=2

# Recomendaciones: razonamiento DESACTIVADO. Medido, es más rápido, más barato
# y mucho más fiable que dejarlo activado (fallaba 2 de cada 3 veces).
DEEPSEEK_SUGGESTIONS_THINKING=disabled
DEEPSEEK_SUGGESTIONS_MAX_TOKENS=4000
RECOMMENDATIONS_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Imágenes
# ---------------------------------------------------------------------------
IMAGE_MAX_SIZE_MB=8
