# Servidor
PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Día lógico del usuario
#
# El servidor corre en UTC, pero el "día" de la app tiene que ser el del
# usuario. El navegador manda su zona en la cabecera X-Timezone; APP_TIMEZONE
# es el respaldo cuando no llega o no es válida.
#
# DAY_START_HOUR es la hora a la que cambia el día:
#   0 -> a medianoche local
#   1 -> a la 01:00 local: lo comido entre las 00:00 y la 01:00 sigue contando
#        para el día anterior, que es lo práctico si se cena tarde.
#
# Sin esto, y con el servidor en UTC, en Argentina el resumen del día se
# vaciaba a las 21:00 y las cenas posteriores aparecían en el día siguiente.
# ---------------------------------------------------------------------------
APP_TIMEZONE=America/Argentina/Buenos_Aires
DAY_START_HOUR=1

# ---------------------------------------------------------------------------
# Recordatorios de agua por notificaciones push — OPCIONALES
#
# Sin estas claves, todo lo demás funciona igual y la app simplemente no ofrece
# los recordatorios. El servidor lo detecta solo: si `VAPID_PUBLIC_KEY` está
# vacía, no aparecen avisos ni errores.
#
# GENÉRALAS TÚ, y hazlo EN EL SERVIDOR: la privada no debería pasar por ningún
# otro sitio (ni por un chat, ni por un repositorio).
#
#     cd backend && node -e "import('web-push').then(m => console.log(m.default.generateVAPIDKeys()))"
#
# La pública acaba en el navegador, así que no es secreta. La privada SÍ: con
# ella se pueden enviar notificaciones a tus usuarios.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que exige el protocolo push. Puede ser un mailto: o una URL.
VAPID_SUBJECT=mailto:tu@email.com

# Poner en "false" para desactivar el planificador sin borrar las claves.
WATER_REMINDERS_ENABLED=true

# Orígenes permitidos por CORS (separados por coma).
# Admite comodines con '*', útil para orígenes que cambian:
#   https://*.trycloudflare.com   -> cualquier túnel de cloudflared
#   http://192.168.*.*:5173       -> red local
# En producción lista solo tus dominios exactos, sin comodines.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://*.trycloudflare.com

# Autenticación — GENERA UN SECRETO PROPIO EN PRODUCCIÓN
# openssl rand -base64 48
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# URL del frontend. Es solo un RESPALDO para armar el enlace de
# restablecimiento: el backend prefiere el origen desde el que se hizo la
# petición, así el enlace funciona sin configurar nada (localhost, túnel o
# dominio real).
FRONTEND_URL=http://localhost:5173

# Cuánto dura el enlace de restablecimiento, en minutos
PASSWORD_RESET_MINUTES=60

# ---------------------------------------------------------------------------
# Correo (opcional)
#
# Se usa para enviar el enlace de restablecimiento de contraseña. Si NO se
# configura, el enlace se escribe en el registro del servidor en lugar de
# fallar: suficiente si administras tú el servidor.
#
# Con Gmail necesitas una "contraseña de aplicación", no la de tu cuenta.
# ---------------------------------------------------------------------------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=tu@email.com
# EMAIL_PASS=clave_de_aplicacion
# EMAIL_FROM=NutriTrack <no-responder@tudominio.com>

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutritrack

# TLS hacia PostgreSQL. Déjalo en false con PostgreSQL autoalojado (local,
# Docker, VPS): esos servidores no hablan SSL por defecto y activarlo hace que
# toda consulta falle con "The server does not support SSL connections".
# Ponlo en true con proveedores gestionados: Supabase, Neon, Railway, Render, RDS.
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# DeepSeek API  —  LA API KEY VIVE SOLO AQUÍ, NUNCA EN EL FRONTEND
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-tu_api_key_de_deepseek
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Modelo usado para analizar IMÁGENES (debe ser multimodal).
# Si tu cuenta no tiene acceso a visión, apunta DEEPSEEK_API_URL a un gateway
# compatible con el formato OpenAI (content array con image_url).
DEEPSEEK_VISION_MODEL=deepseek-chat

# Modelo usado para generar recomendaciones de texto
DEEPSEEK_TEXT_MODEL=deepseek-chat

# Timeout del análisis de imagen en milisegundos
DEEPSEEK_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# Presupuesto de tokens
#
# IMPORTANTE: los modelos de razonamiento emiten `reasoning_content` además de
# `content`, y esos tokens CUENTAN dentro de max_tokens. Si el presupuesto se
# agota mientras razonan, la respuesta llega vacía o truncada
# (finish_reason: "length").
# ---------------------------------------------------------------------------

# Análisis de imágenes. Necesita razonar, y consume 2.000-4.000 tokens solo en
# eso: no lo bajes de 8000 o empezarán a fallar análisis.
DEEPSEEK_MAX_TOKENS=8000

# Intentos del análisis de imagen. Medido contra la API real: 1 de cada ~7
# análisis devolvía el JSON truncado (transitorio). Con 2 intentos: 10/10
# correctos seguidos. Con 1 se desactiva el reintento.
DEEPSEEK_ANALYSIS_ATTEMPTS=2

# Recomendaciones de texto. Aquí el razonamiento se DESACTIVA (ver abajo)
# porque se desbocaba: con "minimal" fallaban 2 de cada 3 peticiones.
DEEPSEEK_SUGGESTIONS_MAX_TOKENS=4000

# "disabled" (por defecto) | "enabled"
# Desactivado: 3/3 respuestas válidas en 2,8 s y 0 tokens de razonamiento.
# Activado:    1/3 válidas, 24 s y ~6.400 tokens. No lo actives salvo que
#              quieras que el modelo "piense" los platos, a un coste alto.
DEEPSEEK_SUGGESTIONS_THINKING=disabled

# Solo se usa si DEEPSEEK_SUGGESTIONS_THINKING=enabled
# DEEPSEEK_SUGGESTIONS_REASONING_EFFORT=minimal

# ---------------------------------------------------------------------------
# Caché de recomendaciones
#
# Evita volver a llamar a la IA cuando el usuario reabre la pantalla de
# recomendaciones sin que haya cambiado nada. Registrar una comida o cambiar
# el perfil la invalidan automáticamente.
# ---------------------------------------------------------------------------
RECOMMENDATIONS_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Almacenamiento de imágenes
# Política: se re-codifican a JPEG (~150 KB), se eliminan los metadatos EXIF
# y se borran del disco cuando se elimina el registro de comida asociado.
# ---------------------------------------------------------------------------
IMAGE_UPLOAD_PATH=./uploads
IMAGE_MAX_SIZE_MB=8
